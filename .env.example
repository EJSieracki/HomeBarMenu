# Supabase PostgreSQL
# Transaction pooler — used at runtime (required for Netlify serverless)
# Find in: Supabase > Settings > Database > Connection pooling > Transaction mode
DATABASE_URL="postgresql://postgres.[project-id]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Direct connection — used by prisma migrate / prisma db push only
# Find in: Supabase > Settings > Database > Connection string > URI
DIRECT_URL="postgresql://postgres:[db-password]@db.[project-id].supabase.co:5432/postgres"

# Generate with: openssl rand -base64 32
AUTH_SECRET="your-secret-here"

NEXTAUTH_URL="https://your-site.netlify.app"
